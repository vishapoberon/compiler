s3:
	@printf '\nMaking s3 library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_S3); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/s3/$$name.Mod" || exit; done




ports:
	@printf '\nMaking portable ports for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_PORTABLE); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/$$name.Mod" || exit; done
	@if [ "$(PLATFORM)" = unix ]; then \
	  cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_UNIX_PORTS); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/$$name.Mod" || exit; done; \
	fi
	@if [ "$(WITH_NETWORK)" != 0 ] && [ "$(PLATFORM)" = unix ] && [ "$$(uname -s)" = Linux ]; then \
	  cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_LINUX_PORTS); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/$$name.Mod" || exit; done; \
	else echo 'Skipping the Linux networking profile.'; fi

O2library: runtime terminal cli v4 ooc xml xmpp ulm pow32 misc s3 ports

OClibrary: runtime terminal

library:
	@printf '\nCompiling lib$(ONAME)-O$(MODEL) sources\n'
	rm -rf $(BUILDDIR)/$(MODEL)
	mkdir -p $(BUILDDIR)/$(MODEL)
	cp $(BUILDDIR)/SYSTEM.[ho] $(BUILDDIR)/$(MODEL)
	cp src/runtime/*.Txt  $(BUILDDIR)/$(MODEL)
	cp $(BUILDDIR)/WindowsWrapper.h $(BUILDDIR)/$(MODEL)
	@make -f src/tools/make/oberon.mk -s O$(MODEL)library MODEL=$(MODEL)
	@printf '\nMaking lib$(ONAME)-O$(MODEL) .a and .so\n'
	ar rcs "$(BUILDDIR)/$(MODEL)/lib$(ONAME)-O$(MODEL).a" $(BUILDDIR)/$(MODEL)/*.o
	@cd $(BUILDDIR)/$(MODEL) && $(COMPILE) -shared -o lib$(ONAME)-O$(MODEL)$(DYNEXT) *.o



sourcechanges:
	@cd $(BUILDDIR) && sh "$(ROOTDIR)/src/tools/make/sourcechanges.sh" "$(ROOTDIR)/bootstrap/$(PLATFORM)-$(ADRSIZE)$(ALIGNMENT)"



RUNTEST = COMPILER=$(COMPILER) OBECOMP="$(OBECOMP) -O$(MODEL)" FLAVOUR=$(FLAVOUR) BRANCH=$(BRANCH) sh ./test.sh "$(ROOTDIR)/install"

confidence:
	@printf '\n\n--- Confidence tests ---\n\n'
	sh src/test/bootstrap/test-sourcechanges.sh
	cd src/test/confidence/hello;           $(RUNTEST)
	cd src/test/confidence/out;             $(RUNTEST)
	cd src/test/confidence/in;              $(RUNTEST)
	cd src/test/confidence/math;            $(RUNTEST)
	cd src/test/confidence/intsyntax;       $(RUNTEST)
	cd src/test/confidence/language;        $(RUNTEST)
	cd src/test/confidence/arrayassignment; $(RUNTEST)
	cd src/test/confidence/arrayparameters; $(RUNTEST)
	cd src/test/confidence/filesafety;      $(RUNTEST)
	cd src/test/confidence/heaproots;       $(RUNTEST)
	cd src/test/confidence/ckeywords;       $(RUNTEST)
	cd src/test/confidence/texts;           $(RUNTEST)
	cd src/test/confidence/library;         $(RUNTEST)
	@if [ "$(MODEL)" = 2 ]; then $(MAKE) -C src/ports/xml test VOC="$(ROOTDIR)/install/bin/$(OBECOMP)" VOCROOT="$(ROOTDIR)/install" BUILD="$(ROOTDIR)/$(BUILDDIR)/xml-tests"; fi
	$(MAKE) -C src/test/ports test VOC="$(ROOTDIR)/install/bin/$(OBECOMP)" VOCROOT="$(ROOTDIR)/install" MODEL=$(MODEL) BUILD="$(ROOTDIR)/$(BUILDDIR)/port-tests"
	@if [ "$(PLATFORM)" = unix ] && [ "$(MODEL)" = 2 ]; then \
	  $(MAKE) -C src/test/ports/sts-q test-bundled VOC="$(ROOTDIR)/install/bin/$(OBECOMP)" VOCROOT="$(ROOTDIR)/install" MODEL=$(MODEL) BUILD="$(ROOTDIR)/$(BUILDDIR)/kbd-tests"; \
	fi
	cd src/test/confidence/isptest;         $(RUNTEST)
	cd src/test/confidence/lola;            $(RUNTEST)
	if [ "$(PLATFORM)" != "windows" ] ; then cd src/test/confidence/signal; $(RUNTEST); fi
	if [ "$(PLATFORM)" = "unix" ] ; then cd src/test/platform; $(RUNTEST); fi
	if [ "$(PLATFORM)" = "unix" ] ; then cd src/test/terminal; $(RUNTEST); fi
	@if [ "$(PLATFORM)" = unix ]; then python3 src/tools/none/test-editor.py "$(ROOTDIR)/install/bin/none" --work "$(ROOTDIR)/$(BUILDDIR)/editor-tests"; fi
	if [ "$(PLATFORM)" = "unix" ] && [ "$$(uname -s)" = "Linux" ] ; then cd src/test/confidence/platformwrite; $(RUNTEST); fi
	@printf '\n\n--- Confidence tests passed ---\n\n'
