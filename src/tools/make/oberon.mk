	@printf '\nMaking run time library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/PlatformNative$(PLATFORM).Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/Platform$(PLATFORM).Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/Heap.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Out.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/Modules.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Reals.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Strings.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/In.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/VT100.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Files.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Math.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/MathL.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/runtime/Texts.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/Oberon.Mod


cli:
	@printf '\nMaking command-line library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_CLI); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/library/$$name.Mod" || exit; done

terminal:
	@if [ "$(PLATFORM)" = unix ]; then \
	  printf '\nMaking Unix terminal library for -O$(MODEL)\n'; \
	  cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_TERMINAL); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/library/terminal/$$name.Mod" || exit; done; \
	fi

v4:
	@printf '\nMaking v4 library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/v4/Printer.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/v4/Sets.Mod

ooc:
	@printf '\nMaking unified oo2c library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_OOC); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/ooc/$$name.Mod" || exit; done
	cd $(BUILDDIR)/$(MODEL) && "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/ooc/C$(DATAMODEL).Mod"

oocX11:
	@printf '\nMaking oocX11 library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/oocX11/oocX11.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/oocX11/oocXutil.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/oocX11/oocXYplane.Mod

xml: ooc
	@printf '\nMaking XML library for -O$(MODEL)\n'
	@test "$(MODEL)" = 2 || { echo 'The XML port targets model 2.'; exit 1; }
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_XML); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/xml/$$name.Mod" || exit; done

xmpp: xml
	@printf '\nMaking XMPP library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_XMPP); do "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/xmpp/$$name.Mod" || exit; done

ulm:
	@printf '\nMaking ulm library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL) && for name in $(MODULAR_ULM); do \
	  case "$$name:$(PLATFORM)" in UnixFiles:unix|UnixTerminals:unix) ;; UnixFiles:*|UnixTerminals:*) continue ;; esac; \
	  "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) "$(ROOTDIR)/src/ports/ulm/$$name.Mod" || exit; \
	done

pow32:
	@printf '\nMaking pow library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/ports/pow/powStrings.Mod

misc:
	@printf '\nMaking misc library for -O$(MODEL)\n'
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/misc/crt.Mod
	cd $(BUILDDIR)/$(MODEL); "$(ROOTDIR)/$(OBECOMP)" -Fs -O$(MODEL) ../../../src/library/misc/Listen.Mod
