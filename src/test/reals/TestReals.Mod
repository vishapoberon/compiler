MODULE TestReals;
IMPORT SYSTEM, Reals, Out;

PROCEDURE Single(text: ARRAY OF CHAR; expected: SYSTEM.INT32);
  VAR value: REAL;
BEGIN
  value := Reals.ParseReal(text);
  ASSERT(SYSTEM.VAL(SYSTEM.INT32, value) = expected)
END Single;

PROCEDURE Double(text: ARRAY OF CHAR; expected: SYSTEM.INT64);
  VAR value: LONGREAL; formatted: ARRAY 40 OF CHAR;
BEGIN
  value := Reals.ParseLongReal(text);
  ASSERT(SYSTEM.VAL(SYSTEM.INT64, value) = expected);
  IF SYSTEM.LSH(expected, -52) MOD 2048 # 2047 THEN
    Reals.FormatLongReal(value, formatted);
    value := Reals.ParseLongReal(formatted);
    ASSERT(SYSTEM.VAL(SYSTEM.INT64, value) = expected)
  END
END Double;

BEGIN
  Single("0.0", 0); Single("-0.0", MIN(SYSTEM.INT32));
  Single("-1.0", -1082130432);
  Single("1.06E7", 4B21BE40H);
  Single("1.000000059604644775390625E0", 3F800000H);
  Single("1.000000059604644775390626E0", 3F800001H);
  Single("1.1754943508222875E-38", 800000H);
  Single("1.4012984643248171E-45", 1);
  Single("7.006492321624085E-46", 0);
  Single("7.006492321624086E-46", 1);
  Single("3.4028234663852886E38", 7F7FFFFFH);
  Single("3.4028235677973367E38", 7F800000H);
  Single("-1.0E40000", -8388608);
  Single("-1.0E-40000", MIN(SYSTEM.INT32));
  Double("0.0", 0); Double("-0.0", MIN(SYSTEM.INT64));
  Double("1.1D3", 4091300000000000H);
  Double("1.00000000000000011102230246251565404236316680908203125D0", 3FF0000000000000H);
  Double("1.00000000000000011102230246251565404236316680908203126D0", 3FF0000000000001H);
  Double("2.2250738585072014D-308", 10000000000000H);
  Double("4.9406564584124654D-324", 1);
  Double("2.4703282292062327D-324", 0);
  Double("2.4703282292062328D-324", 1);
  Double("1.7976931348623157D308", 7FEFFFFFFFFFFFFFH);
  Double("1.7976931348623159D308", 7FF0000000000000H);
  Double("-1.0D40000", -4503599627370496);
  Double("-1.0D-40000", MIN(SYSTEM.INT64));
  Out.String("pure Oberon numeric conversions passed"); Out.Ln
END TestReals.
