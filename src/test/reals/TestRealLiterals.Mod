MODULE TestRealLiterals;
IMPORT SYSTEM, Out;
CONST
  small = 1.4012984643248171E-45;
  tiny = 4.9406564584124654D-324;
  maximum = 1.7976931348623157D308;
VAR r: REAL; d: LONGREAL;
BEGIN
  r := 1.06E7; ASSERT(r = 10600000.0);
  d := 1.1D3; ASSERT(d = 1100.0D0);
  r := small; ASSERT(SYSTEM.VAL(SYSTEM.INT32, r) = 1);
  d := tiny; ASSERT(SYSTEM.VAL(SYSTEM.INT64, d) = 1);
  d := maximum; ASSERT(SYSTEM.VAL(SYSTEM.INT64, d) = 7FEFFFFFFFFFFFFFH);
  (* Integral reals outside the host ENTIER range still use real emission. *)
  r := 15221402894336.0; ASSERT(r = 1.5221402894336E13);
  d := 15221402894336.0D0; ASSERT(d = 1.5221402894336D13);
  d := 1.00000000000000011102230246251565404236316680908203125D0;
  ASSERT(SYSTEM.VAL(SYSTEM.INT64, d) = 3FF0000000000000H);
  d := 1.00000000000000011102230246251565404236316680908203126D0;
  ASSERT(SYSTEM.VAL(SYSTEM.INT64, d) = 3FF0000000000001H);
  r := -0.0; ASSERT(SYSTEM.VAL(SYSTEM.INT32, r) = MIN(SYSTEM.INT32));
  d := -0.0D0; ASSERT(SYSTEM.VAL(SYSTEM.INT64, d) = MIN(SYSTEM.INT64));
  Out.String("Oberon real literal parsing and emission passed"); Out.Ln
END TestRealLiterals.
