MODULE TestSsqExamples;
IMPORT SYSTEM, Out, Sys := ssqSys, Types := ssqTypes, Char, Int, Random,
  Str, String, Path, Ink, Dot, Clist, Kbd, Line, Text, Viewer;
VAR a, b, path: ARRAY 128 OF CHAR;
  small: ARRAY 4 OF CHAR; empty: ARRAY 1 OF CHAR;
  pos, length, hh, mm, ss, ns, rows, cols: Types.Integer;
  n, d, m: Int.T; s: String.T; cl: Clist.T; l: Line.T; t: Text.T;
  p: Viewer.Pos; screen: Viewer.Screen; key: Kbd.KEY;
BEGIN
  ASSERT(SIZE(Types.Integer) = 4); ASSERT(SIZE(Int.T) = 8);
  ASSERT(Types.Short(2147483647) = 2147483647);
  ASSERT(Types.Short(-2147483647 - 1) = -2147483647 - 1);
  ASSERT(Char.IsDigit('7')); ASSERT(Char.IsAlpha('Z'));
  ASSERT(Char.IsAlphaNumUs('_')); ASSERT(~Char.IsAlpha('3'));
  ASSERT(Int.Fac(10) = 3628800); ASSERT(Int.Fib(10) = 55);
  ASSERT(Int.And(0FF00H, 0F0F0H) = 0F000H);
  ASSERT(Int.Or(0F0H, 0FH) = 0FFH); ASSERT(Int.Xor(0FFH, 0FH) = 0F0H);
  ASSERT(Int.And(-1, 0FFH) = 0FFH);
  Int.Muldivmod(d, m, 16807, 2147483646, 2147483647);
  ASSERT(d = 16806); ASSERT(m = 2147466840);
  Int.Show(a, MIN(Int.T), 0); ASSERT(a = '-9223372036854775808');
  Int.Show(a, 2147483648, 0); ASSERT(a = '2147483648');
  Int.Show(a, 0, 0); ASSERT(a = '0');
  a := '4294967296;'; pos := 0;
  ASSERT(Int.Read(a, pos) = 4294967296); ASSERT(pos = 10);
  n := Random.Next(); ASSERT((n > 0) & (n < 2147483647));
  ASSERT((Random.Roll(7) >= 0) & (Random.Roll(7) < 7));
  a := 'abc'; Str.Append(a, 'def'); ASSERT(a = 'abcdef');
  b := 'cd'; pos := 0; ASSERT(Str.FindSeq(a, b, pos)); ASSERT(pos = 2);
  Str.Sub(b, a, 1, 4); ASSERT(b = 'bcd');
  s := String.Create('hello'); ASSERT(String.Length(s) = 5);
  path := '/tmp/example.Mod'; Path.Directory(a, path); ASSERT(a = '/tmp/');
  Path.FileBasename(a, path); ASSERT(a = 'example');
  Path.FileExtension(a, path); ASSERT(a = 'Mod');
  ASSERT(Path.FileType(a, path)); ASSERT(a = 'obn/voc');
  ASSERT(Ink.WHITE = '255;255;255');
  Clist.New(cl); Clist.AppendAOC(cl, 'ab'); Clist.AppendChar(cl, 'c');
  Clist.AsAOC(cl, a); ASSERT(a = 'abc'); ASSERT(Clist.Length(cl) = 3);
  ASSERT(Clist.HasChar(cl, 'b'));
  l := Line.Create('  hello  '); l := Line.Despace(l);
  ASSERT(l^ = '  hello'); ASSERT(Line.Indentation(l) = 2);
  l := Line.Indent(l, 1); ASSERT(l^ = ' hello');
  Text.New(t, 8); Text.AppendLine(t, l); ASSERT(Text.Length(t) = 1);
  Text.CharInsert(t, 0, 1, 'X'); l := Text.GetLine(t, 0); ASSERT(l^ = ' Xhello');
  Text.CharDelete(t, 0, 1); l := Text.GetLine(t, 0); ASSERT(l^ = ' hello');
  ASSERT(Text.IsModified(t)); ASSERT(Text.NofChars(t) = 7);
  NEW(p); p.x0 := 0; p.y0 := 0; p.cx := 0; p.cy := 0;
  screen := Viewer.NewScreen('test', 1, 1, 20, 60, t, p); ASSERT(screen # NIL);
  key := Kbd.FKey(Kbd.CM, Kbd.Up); ASSERT(Kbd.IsFKey(key));
  ASSERT(Kbd.Fun(key) = Kbd.Up);
  Kbd.ShowKey(a, key); ASSERT(a = '<CM-Up>');
  key := Kbd.MKey(Kbd.Ctrl, Kbd.B1, 12, 34);
  Kbd.Mouse(length, rows, cols, key);
  ASSERT((length = Kbd.B1) & (rows = 12) & (cols = 34));
  Sys.TimeValues(hh, mm, ss, 0); ASSERT((hh = 2) & (mm = 0) & (ss = 0));
  ASSERT(Sys.Nanotime(length, ns)); ASSERT((ns >= 0) & (ns < 1000000000));
  Sys.NanoSleep(0, 1000); Sys.XtermSize(rows, cols);
  path := 'ssq-file-test.txt';
  ASSERT(Sys.FileWrite(path, 'abc', 3)); ASSERT(Sys.FileExists(path));
  ASSERT(Sys.FileRead(small, length, path)); ASSERT(length = 3); ASSERT(small = 'abc');
  ASSERT(~Sys.FileRead(empty, length, path)); ASSERT(empty[0] = 0X);
  ASSERT(Sys.FileAppendLine(path, 'def'));
  ASSERT(Sys.FileRead(a, length, path)); ASSERT(length = 7);
  ASSERT((a[0] = 'a') & (a[3] = 'd') & (a[6] = 0AX) & (a[7] = 0X));
  ASSERT(~Sys.FileRead(small, length, path)); ASSERT(small[3] = 0X);
  ASSERT(Sys.FileWrite(path, '', 0)); ASSERT(Sys.FileRead(empty, length, path));
  ASSERT(length = 0); ASSERT(~Sys.FileWrite(path, 'x', 3));
  ASSERT(~Sys.FileRead(a, length, 'missing-ssq-file')); ASSERT(length = 0);
  Out.String('sts-q private example support tests passed'); Out.Ln
END TestSsqExamples.
