MODULE TLSTestBytes;  (* TLSBytes against values computed elsewhere (Python) *)

IMPORT TLSBytes, Out;

VAR fails, checks: LONGINT;

PROCEDURE Check32(what: ARRAY OF CHAR; got, want: LONGINT);
BEGIN
  INC(checks);
  IF got # want THEN
    INC(fails); Out.String("FAIL "); Out.String(what); Out.String(": got "); Out.Int(got, 0);
    Out.String(", want "); Out.Int(want, 0); Out.Ln
  END
END Check32;

PROCEDURE Numbers;
BEGIN
  Check32("add", TLSBytes.Add32(0, 0), 0);
  Check32("add", TLSBytes.Add32(0, 1), 1);
  Check32("add", TLSBytes.Add32(0, -1), -1);
  Check32("add", TLSBytes.Add32(0, 2147483647), 2147483647);
