PROCEDURE Buffers;
VAR b, n: TLSBytes.Buffer;
BEGIN
  TLSBytes.Init(b);
  TLSBytes.PutBE32(b, -1); TLSBytes.PutBE32(b, (-2147483647-1)); TLSBytes.PutBE32(b, 12345678H);
  TLSBytes.PutBE16(b, 0FFFEH); TLSBytes.PutBE24(b, 0ABCDEFH); TLSBytes.PutBE64(b, 1, -2);
  Check32("len", b.len, 12 + 2 + 3 + 8);
  Check32("be32 -1", TLSBytes.GetBE32(b, 0), -1);
  Check32("be32 min", TLSBytes.GetBE32(b, 4), (-2147483647-1));
  Check32("be32", TLSBytes.GetBE32(b, 8), 12345678H);
  Check32("be16", TLSBytes.GetBE16(b, 12), 0FFFEH);
  Check32("be24", TLSBytes.GetBE24(b, 14), 0ABCDEFH);
  Check32("be64 hi", TLSBytes.GetBE32(b, 17), 1);
  Check32("be64 lo", TLSBytes.GetBE32(b, 21), -2);
  Check32("byte 0", ORD(b.data[0]), 255); Check32("byte 4", ORD(b.data[4]), 128);
  TLSBytes.SeqNum12(258, n);
  Check32("seq len", n.len, 12); Check32("seq 0", TLSBytes.GetBE32(n, 0), 0);
  Check32("seq 4", TLSBytes.GetBE32(n, 4), 0); Check32("seq 8", TLSBytes.GetBE32(n, 8), 258);
  Check32("xorbyte", TLSBytes.XorByte(0F0H, 0FFH), 0FH)
END Buffers;

BEGIN
  fails := 0; checks := 0;
  Numbers; Buffers;
  Out.String("TLSTestBytes: "); Out.Int(checks, 0); Out.String(" checks, "); Out.Int(fails, 0); Out.String(" failed"); Out.Ln
END TLSTestBytes.
