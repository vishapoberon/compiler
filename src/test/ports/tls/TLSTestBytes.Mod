  Check32("shr", TLSBytes.Shr32((-2147483647-1), 17), 16384);
  Check32("rotr", TLSBytes.Rotr32((-2147483647-1), 31), 1);
  Check32("shr", TLSBytes.Shr32((-2147483647-1), 31), 1);
  Check32("not", TLSBytes.Not32(65535), -65536);
