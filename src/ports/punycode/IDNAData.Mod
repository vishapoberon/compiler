PROCEDURE Word*(index: LONGINT): LONGINT;
  VAR offset, i, value, digit, block: LONGINT; byte: CHAR;
BEGIN
  ASSERT((index >= 0) & (index < 20942));
  offset := index MOD 128 * 6; value := 0; block := index DIV 128;
  FOR i := 0 TO 5 DO
    CASE block DIV 128 OF
    | 0: byte := Byte0(block MOD 128, offset+i)
    | 1: byte := Byte1(block MOD 128, offset+i)
    ELSE HALT(99)
    END;
    digit := ORD(byte)-ORD("0"); IF digit > 9 THEN DEC(digit, 7) END;
    value := value*16+digit
  END;
  RETURN value
END Word;


PROCEDURE Properties*(character: LONGINT): LONGINT;
  VAR lo, hi, mid: LONGINT;
BEGIN
  lo := 0; hi := propertiesCount;
  WHILE lo+1 < hi DO
    mid := (lo+hi) DIV 2;
    IF Word(mid*2) <= character THEN lo := mid ELSE hi := mid END
  END;
  RETURN Word(lo*2+1)
END Properties;

PROCEDURE Combining*(character: LONGINT): LONGINT;
